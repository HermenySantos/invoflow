# HTTPS certificates are obtained and renewed automatically for {$DOMAIN} and www.{$DOMAIN}.
{$DOMAIN} {
	encode zstd gzip

	# The API is served straight from FastAPI; everything else is the Next.js app.
	handle /api/* {
		reverse_proxy api:8000
	}
	# /health is liveness; /health/detailed is readiness (rate limited in the API).
	@health path /health /health/*
	handle @health {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format console
	}
}

# www is only a permanent redirect to the main domain, keeping path and query.
www.{$DOMAIN} {
	redir "https://{$DOMAIN}{uri}" permanent

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
