# Copy to /opt/invoflow/.env on the server (chmod 600). Never commit the real file.

# ── Site ──
DOMAIN=invoflow.example.pt
IMAGE_TAG=latest

# ── Database (local Postgres container) ──
POSTGRES_PASSWORD=change-me-long-random

# ── Auth: Clerk production instance ──
# Mock auth is off unless MOCK_AUTH=1, and production refuses to start with it on.
# Leave MOCK_AUTH unset here.
AUTH_MOCK_MODE=false
CLERK_SECRET_KEY=sk_live_...
CLERK_FRONTEND_API=clerk.invoflow.example.pt
# CLERK_JWKS_URL=   (optional; derived from CLERK_FRONTEND_API)

# ── Receipt files: Cloudflare R2 ──
STORAGE_MOCK_MODE=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=invoflow-documents
# Empty uses the EU jurisdiction endpoint:
# https://<account_id>.eu.r2.cloudflarestorage.com
# Set this only for the default jurisdiction (https://<account_id>.r2.cloudflarestorage.com)
# or another S3-compatible store.
R2_ENDPOINT_URL=

# ── Backups: pg_dump to R2 (separate bucket recommended) ──
# Empty uses https://<account_id>.eu.r2.cloudflarestorage.com on its own.
# It does not follow R2_ENDPOINT_URL.
BACKUP_ENDPOINT_URL=
BACKUP_BUCKET=invoflow-backups
BACKUP_HOUR_UTC=3
BACKUP_KEEP_DAYS=30

# ── OCR ──
OCR_BACKEND=tesseract

# ── Errors (optional) ──
SENTRY_DSN=

# ── e-Fatura test environment (off). No production port, no secrets in git. ──
EFATURA_PULL_ENABLED=false
EFATURA_ENDPOINT=
EFATURA_USERNAME=
EFATURA_PASSWORD=
EFATURA_AT_PUBLIC_KEY_PEM=
EFATURA_CLIENT_CERT_PEM=
EFATURA_CLIENT_KEY_PEM=
