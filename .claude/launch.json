{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--app-dir", "backend", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    },
    {
      "name": "frontend-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": ["NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=", "CLERK_SECRET_KEY=", "npm", "--prefix", "frontend", "run", "dev", "--", "--port", "3001"],
      "port": 3001
    },
    {
      "name": "frontend-prod-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": ["NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=", "CLERK_SECRET_KEY=", "npm", "--prefix", "frontend", "run", "start", "--", "--port", "3002"],
      "port": 3002
    }
  ]
}
