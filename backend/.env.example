# Invoflow backend
# Copy to .env — defaults already run a local demo without paid keys.

# App
# Do not set DEBUG. Settings reject unknown names (extra_forbidden).
# APP_DEBUG defaults to false. Set APP_DEBUG=true only while debugging locally.
# Anything other than "development" refuses to start with mock auth or mock storage.
APP_ENV=development

# Database
# Leave unset (or use SQLite) for the no-Docker path.
# DATABASE_URL=sqlite:///./invoflow.db
# Docker Compose Postgres:
# DATABASE_URL=postgresql://invoflow:invoflow_dev@localhost:5432/invoflow

# Auth — mock by default (any email on the sign-in page)
AUTH_MOCK_MODE=true
# Optional paid: Clerk
# AUTH_MOCK_MODE=false
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
# CLERK_JWKS_URL=

# Storage — local folder backend/mock_storage by default
STORAGE_MOCK_MODE=true
# Optional paid: Cloudflare R2 (requires boto3)
# STORAGE_MOCK_MODE=false
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=invoflow-documents

# OCR — default auto = Tesseract if installed, otherwise mock. No Azure key needed.
OCR_BACKEND=auto
# OCR_BACKEND=mock
# OCR_BACKEND=tesseract
# TESSERACT_LANG=por+eng
# Optional local LLM polish (Ollama). Leave empty to skip.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# Optional paid: Azure Document Intelligence
# OCR_BACKEND=azure
# AZURE_DOC_ENDPOINT=https://....cognitiveservices.azure.com/
# AZURE_DOC_KEY=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# e-Fatura (AT) — off. Test environment only. Leave the secrets empty.
# Documented test URL, not a default and not the production port:
# https://servicos.portaldasfinancas.gov.pt:725/fatshare/ws/fatshareFaturas
EFATURA_PULL_ENABLED=false
EFATURA_ENDPOINT=
EFATURA_USERNAME=
EFATURA_PASSWORD=
EFATURA_AT_PUBLIC_KEY_PEM=
EFATURA_CLIENT_CERT_PEM=
EFATURA_CLIENT_KEY_PEM=
