# InvoFlow Backend Configuration
# Copy this to .env and fill in your values

# App
DEBUG=true

# Database
DATABASE_URL=postgresql://invoflow:invoflow_dev@localhost:5432/invoflow

# Clerk Auth (leave empty for mock mode)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
AUTH_MOCK_MODE=true

# Cloudflare R2 Storage (leave empty for mock mode)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=invoflow-documents
R2_PUBLIC_URL=
STORAGE_MOCK_MODE=true

# Azure Document Intelligence (leave empty for mock mode)
AZURE_DOC_ENDPOINT=
AZURE_DOC_KEY=
OCR_MOCK_MODE=true

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
