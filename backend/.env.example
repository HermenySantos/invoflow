# Invoflow backend
# Copy to .env — defaults already run a local demo without paid keys.

# App
# Do not set DEBUG. Settings reject unknown names (extra_forbidden).
# APP_DEBUG defaults to false. Set APP_DEBUG=true only while debugging locally.
# Mock auth stays on only when this is development or test.
# production, empty, and any other value refuse to start while MOCK_AUTH is set.
# Mock storage is still refused outside development.
APP_ENV=development
# APP_ENV=production refuses to start unless all of these are safe
# (errors name the setting, never its value):
#   DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>   (SQLite is refused)
#   CORS_ORIGINS=https://<your-domain>   (no http, localhost, 127.0.0.1 or *)
#   APP_DEBUG=false

# Database
# Leave unset (or use SQLite) for the no-Docker path.
# DATABASE_URL=sqlite:///./invoflow.db
# Docker Compose Postgres:
# DATABASE_URL=postgresql://invoflow:invoflow_dev@localhost:5432/invoflow

# Auth — off unless this is set, and only while APP_ENV is development or test.
MOCK_AUTH=1
# Real Clerk auth (MOCK_AUTH unset) refuses to start without the Frontend API
# host and the allowed origins. Placeholders only; never commit real keys.
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
# Session tokens must have iss == https://<CLERK_FRONTEND_API>.
# CLERK_FRONTEND_API=your-instance.clerk.accounts.dev
# Web origins allowed in the token's azp claim. Comma-separated or a JSON list.
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# CLERK_JWKS_URL=

# Storage — local folder backend/mock_storage by default
STORAGE_MOCK_MODE=true
# Optional paid: Cloudflare R2 (requires boto3)
# STORAGE_MOCK_MODE=false
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=invoflow-documents

# OCR — default auto = Tesseract if installed, otherwise mock. No Azure key needed.
OCR_BACKEND=auto
# OCR_BACKEND=mock
# OCR_BACKEND=tesseract
# TESSERACT_LANG=por+eng
# Optional local LLM polish (Ollama). Leave empty to skip.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# Optional paid: Azure Document Intelligence
# OCR_BACKEND=azure
# AZURE_DOC_ENDPOINT=https://....cognitiveservices.azure.com/
# AZURE_DOC_KEY=

# Whole-account data export from /settings. false makes GET /api/account/export answer 404.
ACCOUNT_EXPORT_ENABLED=true

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Rate limits on routes that change data. Counted per signed-in user (per IP when
# signed out), per route, in this process's memory. Over the limit: 429 + Retry-After.
# Syntax: "60/minute", "10/second;300/hour". Defaults shown.
# RATE_LIMIT_ENABLED=true
# Edit/delete receipts, VAT on sales save/delete
# RATE_LIMIT_WRITE=60/minute
# Upload link, new receipt, mock file upload
# RATE_LIMIT_UPLOAD=30/minute
# Accountant export (ZIP)
# RATE_LIMIT_EXPORT=5/minute
# e-Fatura import
# RATE_LIMIT_EFATURA=5/minute
# Whole-account data export (ZIP with every receipt file)
# RATE_LIMIT_ACCOUNT_EXPORT=2/minute;10/hour

# e-Fatura (AT) — off. Test environment only. Leave the secrets empty.
# Documented test URL, not a default and not the production port:
# https://servicos.portaldasfinancas.gov.pt:725/fatshare/ws/fatshareFaturas
EFATURA_PULL_ENABLED=false
EFATURA_ENDPOINT=
EFATURA_USERNAME=
EFATURA_PASSWORD=
EFATURA_AT_PUBLIC_KEY_PEM=
EFATURA_CLIENT_CERT_PEM=
EFATURA_CLIENT_KEY_PEM=
